<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=__W__, height=__H__" />
    <title>__TITLE__</title>
    <script src="assets/vendor/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-SemiBold.otf") format("opentype"); font-weight: 600; }
      @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-ExtraBold.otf") format("opentype"); font-weight: 800; }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: __W__px; height: __H__px; overflow: hidden; background: #fafcfc; }
      #root {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #fafcfc;
        color: #1d1d1f;
        font-family: "Inter", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .clip { position: absolute; inset: 0; }
      #stage { position: absolute; inset: 0; }
      /* El logo vive en unidades del SVG original (455 × 466); el contenedor se escala. */
      #logo { position: absolute; left: 0; top: 0; width: 455px; height: 466px; transform-origin: 0 0; }
      #logo svg { position: absolute; left: 0; display: block; overflow: visible; }
      #mark { top: 0; width: 455px; height: 340px; }
      .tline { width: 455px; }
      #name {
        position: absolute;
        font-weight: 800;
        letter-spacing: -0.02em;
        white-space: pre;
        display: flex;
        align-items: center;
      }
      #name .dash { color: #7d8189; font-weight: 600; }
      #name .sag { color: #c4372a; }
      #caret { display: inline-block; width: 5px; border-radius: 3px; background: #1d1d1f; margin-left: 8px; }
      #bar { position: absolute; display: flex; gap: 8px; }
      #bar i { display: block; height: 6px; border-radius: 3px; transform-origin: 0 50%; }
      .tag { position: absolute; left: 0; top: 0; width: 1px; height: 1px; }
      .tag svg { position: absolute; left: 0; top: 0; display: block; }
      .tag .pill { position: absolute; border-radius: 999px; color: #fff; font-weight: 600; white-space: nowrap; background: #1d1d1f; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="3" data-width="__W__" data-height="__H__">
      <section id="intro" class="clip" data-start="0" data-duration="3" data-track-index="0">
        <div id="stage">
          <div id="logo">
            <svg id="mark" viewBox="0 0 455 340">
              <defs>
                <mask id="m-circle" maskUnits="userSpaceOnUse" x="0" y="0" width="455" height="340">
                  <path id="d-circle" d="__CIRCLE_ARC__" pathLength="1" fill="none" stroke="#fff" stroke-width="16" stroke-dasharray="1 1" stroke-dashoffset="1" />
                </mask>
                <mask id="m-ring" maskUnits="userSpaceOnUse" x="0" y="0" width="455" height="340">
                  <path id="d-ring" d="__RING_ARC__" pathLength="1" fill="none" stroke="#fff" stroke-width="70" stroke-dasharray="1 1" stroke-dashoffset="1" />
                </mask>
                <clipPath id="c-serpent"><rect id="r-serpent" x="180" y="252" width="100" height="0" /></clipPath>
              </defs>
              <circle id="dot" cx="__CX__" cy="__CY__" r="13" fill="#c4372a" />
              <path id="circle" d="__CIRCLE__" fill="#c4372a" fill-rule="evenodd" mask="url(#m-circle)" />
              <path id="ring" d="__RING__" fill="#c4372a" fill-rule="evenodd" mask="url(#m-ring)" />
              <g id="rays">__RAYS__</g>
              <path id="staff" d="__STAFF__" fill="#c4372a" />
              <path id="serpent" d="__SERPENT__" fill="#1d1d1f" fill-rule="evenodd" clip-path="url(#c-serpent)" />
            </svg>
__TEXT_LINES__
          </div>
          <div id="name"><span id="typed"></span><span id="caret"></span></div>
          <div id="bar"></div>
          <div id="tags"></div>
        </div>
      </section>
    </div>

    <script>
      (function () {
        const F = __CFG__;
        const RED = "#c4372a";
        const PALETTE = ["#ff9500", "#af52de", "#0a84ff", "#34c759", RED];
        const $ = (s) => document.querySelector(s);

        function build() {
          const tl = gsap.timeline({ paused: true });
          const logo = $("#logo");

          // ---- Posiciones: fase 1 (símbolo solo, grande y centrado) y fase 2 (bloque completo) ----
          const [cx, cy] = F.center;
          const p1 = { scale: F.s1, x: F.W / 2 - cx * F.s1, y: F.H / 2 - cy * F.s1 };
          const logoH = 466 * F.s2;
          const block = logoH + F.gapName + F.nameSize + F.gapBar + 6;
          const top = (F.H - block) / 2;
          const p2 = { scale: F.s2, x: (F.W - 455 * F.s2) / 2, y: top };

          // ---- Nombre "CRS — SAG" (ancho medido para que no salte al escribirse) ----
          const ctx = document.createElement("canvas").getContext("2d");
          ctx.font = "800 " + F.nameSize + "px Inter";
          ctx.letterSpacing = -0.02 * F.nameSize + "px";
          const NAME = "CRS — SAG";
          const nameW = ctx.measureText(NAME).width;
          const name = $("#name");
          const nameTop = top + logoH + F.gapName;
          Object.assign(name.style, { left: F.W / 2 - nameW / 2 + "px", top: nameTop + "px", height: F.nameSize + "px", fontSize: F.nameSize + "px" });
          $("#caret").style.height = Math.round(F.nameSize * 0.95) + "px";
          const typed = $("#typed");
          const render = (k) => {
            const s = NAME.slice(0, k);
            const a = s.slice(0, 3), d = s.slice(3, 6), g = s.slice(6);
            typed.innerHTML = a + (d ? '<span class="dash">' + d + "</span>" : "") + (g ? '<span class="sag">' + g + "</span>" : "");
          };
          render(0);

          // ---- Barra de paleta (los colores del clip convergen en el rojo CRS) ----
          const bar = $("#bar");
          const segW = F.segW;
          PALETTE.forEach((c) => {
            const i = document.createElement("i");
            i.style.background = c;
            i.style.width = segW + "px";
            bar.appendChild(i);
          });
          const barW = PALETTE.length * segW + (PALETTE.length - 1) * 8;
          Object.assign(bar.style, { left: F.W / 2 - barW / 2 + "px", top: nameTop + F.nameSize + F.gapBar + "px" });

          // ---- Cursor multijugador "CRS" ----
          const f = F.tagFont;
          const tag = document.createElement("div");
          tag.className = "tag";
          const a = Math.round(f * 0.95);
          tag.innerHTML =
            '<svg viewBox="0 0 22 22" width="' + a + '" height="' + a + '"><path d="M2 2 L19 9.5 L11.2 11.4 L8.6 19.5 Z" fill="#1d1d1f" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg>' +
            '<div class="pill" style="font-size:' + f + "px;left:" + Math.round(f * 0.72) + "px;top:" + Math.round(f * 0.9) + "px;padding:" + Math.round(f * 0.4) + "px " + Math.round(f * 0.8) + 'px">CRS</div>';
          $("#tags").appendChild(tag);
          const centerScreen = { x: F.W / 2, y: F.H / 2 };
          const tagEnd = { x: F.W / 2 + nameW / 2 + 18, y: nameTop + F.nameSize * 0.55 };

          // =================== Animación (3 s) ===================
          gsap.set(logo, p1);
          gsap.set(".tline", { opacity: 0 });
          gsap.set(["#caret", "#bar"], { opacity: 0 });

          // 0.00 · el cursor CRS llega al centro y "hace clic": nace el punto
          tl.fromTo(tag, { x: centerScreen.x + F.tagFrom[0], y: centerScreen.y + F.tagFrom[1], opacity: 0 }, { x: centerScreen.x + 6, y: centerScreen.y + 6, opacity: 1, duration: 0.3, ease: "power3.out" }, 0);
          tl.to(tag, { scale: 0.86, duration: 0.06, yoyo: true, repeat: 1 }, 0.28);
          tl.fromTo("#dot", { scale: 0, svgOrigin: cx + " " + cy }, { scale: 1, duration: 0.22, ease: "back.out(3)" }, 0.3);
          // 0.45 · el punto se expande como una onda y dibuja el círculo exterior
          tl.to("#dot", { scale: 13, opacity: 0, duration: 0.6, ease: "expo.out", svgOrigin: cx + " " + cy }, 0.5);
          tl.to("#d-circle", { attr: { "stroke-dashoffset": 0 }, duration: 0.7, ease: "power3.inOut" }, 0.5);
          // 0.55 · la C se traza en sentido antihorario
          tl.to("#d-ring", { attr: { "stroke-dashoffset": 0 }, duration: 0.65, ease: "expo.out" }, 0.6);
          tl.to(tag, { x: centerScreen.x + F.tagAside[0], y: centerScreen.y + F.tagAside[1], duration: 0.6, ease: "power2.inOut" }, 0.55);
          // 0.75 · los rayos entran en los colores del equipo y convergen en el rojo CRS
          F.rays.forEach((r, i) => {
            const id = "#ray" + i;
            const o = r.ox + " " + r.oy;
            tl.fromTo(id, { scale: 0, opacity: 0, fill: PALETTE[i % 4], svgOrigin: o }, { scale: 1, opacity: 1, duration: 0.42, ease: "back.out(2.4)", svgOrigin: o }, 0.75 + i * 0.035);
            tl.to(id, { fill: RED, duration: 0.35, ease: "power1.inOut" }, 1.2 + i * 0.02);
          });
          // 0.9 · el bastón crece desde la base y la serpiente se enrosca hacia arriba
          tl.fromTo("#staff", { scaleY: 0, svgOrigin: "227.5 260" }, { scaleY: 1, duration: 0.45, ease: "power3.out", svgOrigin: "227.5 260" }, 0.9);
          tl.to("#r-serpent", { attr: { y: 84, height: 170 }, duration: 0.55, ease: "power2.inOut" }, 1.05);
          // 1.35 · el símbolo se acomoda y aparecen las líneas del nombre institucional
          tl.to(logo, { scale: p2.scale, x: p2.x, y: p2.y, duration: 0.55, ease: "expo.inOut" }, 1.3);
          gsap.utils.toArray(".tline").forEach((l, i) =>
            tl.fromTo(l, { opacity: 0, y: 14, filter: "blur(8px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.4, ease: "power3.out" }, 1.55 + i * 0.08)
          );
          // 1.75 · se escribe "CRS — SAG"
          tl.set("#caret", { opacity: 1 }, 1.75);
          tl.set("#bar", { opacity: 1 }, 1.95);
          const o = { n: 0 };
          tl.fromTo(o, { n: 0 }, { n: NAME.length, duration: 0.45, ease: "none", onUpdate() { render(Math.floor(o.n + 0.001)); } }, 1.75);
          tl.fromTo("#caret", { opacity: 1 }, { opacity: 0, duration: 0.2, ease: "steps(1)", repeat: 3, yoyo: true, immediateRender: false }, 2.2);
          tl.fromTo("#bar i", { scaleX: 0 }, { scaleX: 1, duration: 0.45, ease: "power3.out", stagger: 0.05 }, 1.95);
          tl.to(tag, { x: tagEnd.x, y: tagEnd.y, duration: 0.5, ease: "power3.inOut" }, 1.85);
          // 2.25 · respiración final y salida por desenfoque (como el resto del clip)
          tl.fromTo("#stage", { scale: 1, transformOrigin: "50% 50%" }, { scale: 1.025, duration: 0.55, ease: "sine.inOut" }, 2.25);
          tl.to("#stage", { opacity: 0, filter: "blur(16px)", scale: 1.06, duration: 0.2, ease: "power2.in" }, 2.8);

          window.__timelines["main"] = tl;
          if (window.__hfForceTimelineRebind) window.__hfForceTimelineRebind();
        }

        Promise.all([600, 800].map((w) => document.fonts.load(w + " 40px Inter"))).then(() => document.fonts.ready).then(build);
      })();
    </script>
  </body>
</html>
